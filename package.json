{
  "name": "@gg-utils/env-materialize-kit",
  "version": "0.3.0",
  "description": "Reusable env materialization command and config primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli-args": {
      "types": "./dist/cli-args.d.ts",
      "default": "./dist/cli-args.js"
    },
    "./cli-runner": {
      "types": "./dist/cli-runner.d.ts",
      "default": "./dist/cli-runner.js"
    },
    "./command-preview": {
      "types": "./dist/command-preview.d.ts",
      "default": "./dist/command-preview.js"
    },
    "./format-results": {
      "types": "./dist/format-results.d.ts",
      "default": "./dist/format-results.js"
    },
    "./interactive-menu": {
      "types": "./dist/interactive-menu.d.ts",
      "default": "./dist/interactive-menu.js"
    },
    "./ink-wizard-model": {
      "types": "./dist/ink-wizard-model.d.ts",
      "default": "./dist/ink-wizard-model.js"
    },
    "./key-projections": {
      "types": "./dist/key-projections.d.ts",
      "default": "./dist/key-projections.js"
    },
    "./modes": {
      "types": "./dist/modes.d.ts",
      "default": "./dist/modes.js"
    },
    "./opentui-wizard-model": {
      "types": "./dist/opentui-wizard-model.d.ts",
      "default": "./dist/opentui-wizard-model.js"
    },
    "./package-render-values": {
      "types": "./dist/package-render-values.d.ts",
      "default": "./dist/package-render-values.js"
    },
    "./seed-files": {
      "types": "./dist/seed-files.d.ts",
      "default": "./dist/seed-files.js"
    },
    "./target-files": {
      "types": "./dist/target-files.d.ts",
      "default": "./dist/target-files.js"
    },
    "./target-runner": {
      "types": "./dist/target-runner.d.ts",
      "default": "./dist/target-runner.js"
    },
    "./ui-helpers": {
      "types": "./dist/ui-helpers.d.ts",
      "default": "./dist/ui-helpers.js"
    },
    "./ui-launcher": {
      "types": "./dist/ui-launcher.d.ts",
      "default": "./dist/ui-launcher.js"
    },
    "./workspace-values": {
      "types": "./dist/workspace-values.d.ts",
      "default": "./dist/workspace-values.js"
    },
    "./write-target-file": {
      "types": "./dist/write-target-file.d.ts",
      "default": "./dist/write-target-file.js"
    },
    "./package.json": "./package.json",
    "./opentui-app": {
      "types": "./dist/opentui-app.d.ts",
      "default": "./dist/opentui-app.js"
    },
    "./ink-app": {
      "types": "./dist/ink-app.d.ts",
      "default": "./dist/ink-app.js"
    },
    "./check-keys": {
      "types": "./dist/check-keys.d.ts",
      "default": "./dist/check-keys.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@gg-utils/env-materialize-core": "git+https://github.com/gg-utils/env-materialize-core.git#v0.3.0",
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.unit.test.ts\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/env-materialize-kit.git"
  },
  "imports": {
    "#opentui/jsx-runtime": {
      "types": "./dist/opentui-jsx/jsx-runtime.d.ts",
      "default": "./dist/opentui-jsx/jsx-runtime.js"
    }
  },
  "bin": {
    "env-materialize-check-keys": "./dist/check-keys-cli.js"
  }
}
